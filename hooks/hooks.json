{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/fetch_fallback.py\"" }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "WebFetch",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/fetch_fallback.py\"" }
        ]
      }
    ]
  }
}
